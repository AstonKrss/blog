# ============================================================
# 环境变量模板（提交到 Git，供他人参考）
# 使用方法：复制为 .env 并填入真实值。.env 已被 .gitignore 忽略。
# ============================================================

# MySQL root 密码（docker compose）
MYSQL_ROOT_PASSWORD=change-me-root

# 应用数据库账号密码（docker compose）
MYSQL_PASSWORD=change-me-app
SPRING_DATASOURCE_PASSWORD=change-me-app

# JWT 签名密钥（至少 32 位随机字符串）
# 生成示例：node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-at-least-32-chars

# 数据库连接串（本地脚本/前端用）
DATABASE_URL=jdbc:mysql://localhost:3306/myblog?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai&useSSL=false

# QQ 邮箱 SMTP 授权码（注册发验证码用）
MAIL_PASSWORD=your-smtp-auth-code

# RabbitMQ 密码（docker compose）
RABBITMQ_DEFAULT_PASS=change-me-rabbit

# MinIO 凭据（docker compose）
MINIO_ROOT_USER=change-me-user
MINIO_ROOT_PASSWORD=change-me-minio

# 前端 API 地址
NEXT_PUBLIC_API_URL=http://localhost:8080
