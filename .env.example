# ============================================
# 博客系统环境变量配置
# ============================================
# 复制此文件为 .env 并填写真实值
# cp .env.example .env
# Docker Compose 会自动读取 .env 文件
# ⚠️ .env 文件不要提交到 git！

# ===================
# 数据库配置
# ===================
MYSQL_ROOT_PASSWORD=your_mysql_root_password
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/myblog?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai&useSSL=false
SPRING_DATASOURCE_USERNAME=bloguser
SPRING_DATASOURCE_PASSWORD=your_bloguser_password

# ===================
# JWT 配置 (重要！)
# ===================
# JWT 签名密钥，生产环境必须设置复杂的随机字符串（至少32字符）
JWT_SECRET=change_this_to_a_random_secret_key_in_production_at_least_32_chars
JWT_EXPIRATION=86400000

# ===================
# 邮件配置
# ===================
# QQ 邮箱或其他 SMTP 邮箱
MAIL_HOST=smtp.qq.com
MAIL_PORT=587
MAIL_USERNAME=your_email@qq.com
# QQ 邮箱授权码（不是登录密码）
MAIL_PASSWORD=your_mail_auth_code

# ===================
# 博客站点配置
# ===================
BLOG_SITE_URL=https://your-domain.com
BLOG_OWNER_EMAIL=your_email@example.com
BLOG_OWNER_NAME=Aston
